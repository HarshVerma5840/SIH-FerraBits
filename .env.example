# SBOMGuard Environment Variables
# The system falls back to defaults if these are not set.

# Database URL (Default: sqlite:///./sbom_security.db)
# Use PostgreSQL in production: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./sbom_security.db

# JWT Secret for Auth (Change this to a secure random string in production!)
JWT_SECRET=super-secret-sbomguard-cybersecurity-token
